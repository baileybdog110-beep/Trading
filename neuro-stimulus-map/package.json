{
  "name": "neuro-stimulus-map",
  "private": true,
  "version": "0.1.0",
  "description": "Research-based stimulus association map: an educational tool linking detected media features to curated neuroscience evidence.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:evidence": "vitest run tests/evidence.test.ts",
    "evidence:table": "node scripts/evidence/build_table.mjs",
    "verify:citations": "python3 scripts/evidence/verify_citations.py",
    "test:e2e": "vite build && node e2e/smoke.mjs",
    "fixtures": "python3 scripts/testdata/make_fixtures.py",
    "atlas": "python3 scripts/atlas/build_atlas.py --inputs atlas_inputs --out public/atlas"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@vladmandic/face-api": "^1.7.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
