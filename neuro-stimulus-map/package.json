{
  "name": "neuro-stimulus-map",
  "private": true,
  "version": "0.1.0",
  "description": "Research-based stimulus association map: an educational tool linking detected media features to curated neuroscience evidence.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hosted": "tsc --noEmit && node scripts/hosted/make_page.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:evidence": "vitest run tests/evidence.test.ts",
    "evidence:table": "node scripts/evidence/build_table.mjs",
    "verify:citations": "python3 scripts/evidence/verify_citations.py",
    "test:e2e": "vite build && node scripts/tool/build.mjs && node scripts/hosted/make_page.mjs && node e2e/smoke.mjs && node e2e/mobile.mjs && node e2e/tool-smoke.mjs && node e2e/hosted.mjs && node e2e/viewports.mjs",
    "fixtures": "python3 scripts/testdata/make_fixtures.py",
    "atlas": "python3 scripts/atlas/build_atlas.py --inputs atlas_inputs --out public/atlas",
    "dev:phone": "vite --host",
    "preview:phone": "vite build && vite preview --host",
    "build:tool": "node scripts/tool/build.mjs",
    "mcp": "node tool-dist/mcp-stdio.mjs",
    "api": "node tool-dist/http-server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@vladmandic/face-api": "^1.7.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
